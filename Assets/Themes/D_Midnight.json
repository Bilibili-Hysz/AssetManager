{
  "version": 1,
  "name": "Midnight",
  "description": "Very dark blue-black interface with bright blue accents",
  "dark": true,
  "colors": {
    "base": "#080a10",
    "panel": "#10141c",
    "header": "#181e28",
    "border": "#506388",
    "heading": "#e0e8f8",
    "body": "#a8b4cc",
    "muted": "#6b7ea2",
    "accent": "#4090e0",
    "success": "#50d890",
    "warning": "#f5b040",
    "danger": "#f06060",
    "favorite": "#f0d060",
    "recent": "#70b8e0",
    "on_accent": "#000000",
    "hover_overlay": "#ffffff",
    "selected_overlay": "#4090e0",
    "border_focus": "#4090e0",
    "input_bg": "#10141c",
    "input_text": "#e0e8f8",
    "scrollbar_track": "#080a10",
    "scrollbar_thumb": "#506080",
    "scrollbar_thumb_hover": "#58698c",
    "disabled_text": "#304060",
