{
  "version": 1,
  "name": "Amber",
  "description": "Warm dark brown interface with vibrant golden accents",
  "dark": true,
  "colors": {
    "base": "#14100c",
    "panel": "#201814",
    "header": "#2c2018",
    "border": "#584830",
    "heading": "#f0e8d8",
    "body": "#c8b898",
    "muted": "#8a7860",
    "accent": "#d09030",
    "success": "#50d890",
    "warning": "#f5b040",
