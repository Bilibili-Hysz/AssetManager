      "hover": 0.08,
      "disabled": 0.5
    },
    "border_radius": {
      "sm": 4,
      "md": 6,
      "lg": 8
    },
    "spacing": {
      "xs": 4,
      "sm": 8,
      "md": 12,
      "lg": 16
    },
    "font_size": {
      "sm": 11,
      "md": 12,
      "lg": 13,
      "xl": 14
