{
  "version": 1,
  "name": "Nord",
  "description": "Arctic blue-gray interface with frost accents",
  "dark": true,
  "colors": {
    "base": "#2e3440",
    "panel": "#3b4252",
    "header": "#434c5e",
    "border": "#4c566a",
    "heading": "#eceff4",
    "body": "#d8dee9",
    "muted": "#7b88a0",
    "accent": "#88c0d0",
