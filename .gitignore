# Backup copy of the pre-flattened workspace.
/Project/

# Python caches and test artifacts.
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
.pyright/
.coverage
htmlcov/
coverage/

# Virtual environments.
.venv/
venv/
env/

# Build outputs.
build/
dist/
*.spec~

# Runtime data and local files.
/RuntimeData/
/_query_db.py
*.db
*.db-shm
*.db-wal
*.log

# IDE and OS files.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Local agent tooling dependencies.
/.codex/
.worktrees/
.mimocode/node_modules/
.mimocode/.cron-lock
.opencode/node_modules/

# Local agent session and test artifacts.
/.zcode/
/tmp/
/new-session---*.json

# React/Vite local dependencies and generated metadata.
/.vite/
/webui/node_modules/
/webui/dist/
/webui/.vite/
/webui/tsconfig.tsbuildinfo

# Local snapshots retained beside legacy static assets.
AssetsManager/lan/static/*.bak
AssetsManager/lan/static/*.bak2

# Cython generated extension sources and binaries.
AssetsManager/application/asset_filters.c
AssetsManager/core/cache.c
AssetsManager/core/color_utils.c
AssetsManager/core/format_utils.c
*.pyd

# Downloaded Cloudflare Tunnel executable.
/cloudflared-windows-amd64.exe

# Local standalone gate-test sandbox.
/Gate_Test/

# Generated local performance trend evidence.
/artifacts/

# Root-level diagnostic captures generated during local investigations.
/crash_*.txt
/full_crash_output*.txt
/first_half.txt
/root_crash_new.txt
/test_order.txt

# Playwright E2E run artifacts.
/webui/test-results/
/webui/playwright-report/

# The previewer build (webui/previewer-dist/) is vendored on purpose: it is
# produced in a separate workspace, so a fresh clone has no way to rebuild it
# and GET /previewer/* would 503 without these files.  Only the runtime payload
# is tracked -- source maps of third-party minified bundles are 6 MB of no
# diagnostic value here, and the demo models are another 3.5 MB the app never
# requests.  Both stay on disk locally; this only keeps them out of history.
/webui/previewer-dist/**/*.map
/webui/previewer-dist/samples/

# Local bare mirror (backup of this repo's git history).
/mirror/


# Local pytest basetemp (system temp is locked by a privileged process).
# One glob rather than a per-run name: each session picks a fresh basetemp
# because a crashed run leaves its old directory locked by a stale handle.
/.pytest-*/
/.bt-*/
/pytest-run.log
/pytest-full*.log


# Sandbox probe leftovers (0o700 dirs the sandbox cannot delete).
/.probe-*/
/am-probe-*/


# Local agent tooling config (user-provided .zcode/.agents definitions).
/.agents/


# Ad-hoc inventory/probe listings produced while auditing the tree.
# Root-anchored, so the many legitimately underscore-prefixed module files in
# package subdirectories stay tracked.
/*_files.txt
/_*
