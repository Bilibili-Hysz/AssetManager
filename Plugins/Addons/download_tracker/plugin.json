{
  "name": "Download Tracker",
  "id": "download_tracker",
  "version": "2.0.0",
  "author": "",
  "description": "Track import/copy history and expose last-download metadata",
  "enabled": false,
  "entry": "tracker.py:Plugin",
  "kind": "tool_window",
  "permissions": [
    "settings.read",
    "settings.write",
    "filesystem.read"
  ],
  "provides": [
    "info.fields",
    "file.metadata"
  ],
  "display_fields": [
    {
      "key": "last_downloaded",
      "label_key": "info.field_last_downloaded",
      "type": "text"
    },
    {
      "key": "download_count",
      "label_key": "info.field_download_count",
      "type": "number"
    }
  ]
}
