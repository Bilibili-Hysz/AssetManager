+def _suffixed(path: str) -> str:
+    """路径末尾插入 PID，分相保全：同周期首退/重启两个 exe 进程共享
+    环境变量路径，不加后缀会在导出/落盘时互相覆盖（batch-01 S1 已
+    证明 phase-1 事件被 phase-2 flush 覆盖丢失）。"""
+    p = path.strip()
+    if not p:
+        return p
+    stem, dot, ext = p.rpartition(".")
+    if dot and len(stem) > 0 and "/" not in ext and "\\" not in ext and len(ext) <= 5:
+        return f"{stem}.{os.getpid()}.{ext}"
+    return f"{p}.{os.getpid()}"
+
+
+_LOG_PATH = _suffixed(os.environ.get("AM_EXIT_DIAGNOSTIC_LOG", ""))
+_EXPORT_REQUEST = _suffixed(os.environ.get("AM_G3_EXPORT_REQUEST", ""))
+_EXPORT_ACK = _suffixed(os.environ.get("AM_G3_EXPORT_ACK", ""))
+_FINAL_FLUSH = _suffixed(os.environ.get("AM_G3_FINAL_FLUSH", ""))
